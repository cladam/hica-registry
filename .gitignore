.koka
# Track the .hica directory itself (contains .gitkeep so COPY .hica works in Docker)
# but ignore the package cache and build artifacts inside it.
.hica/cache/
.hica/stdlib/
.hica/*.kk
.hica/*.kki

examples/*
!examples/*.hc

src/*
!src/*.hc
!src/sqlite_ffi.kk
!src/sqlite-inline.c

tests/*
!tests/*.hc

registry.*

# tbdflow intent log (local-only, never committed)
.tbdflow-intent.json

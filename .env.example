# Required — generate with:
#   echo -n "your-secret-token" | sha256sum | awk '{print "sha256:" $1}'
HICA_REGISTRY_ADMIN_TOKEN_HASH=sha256:changeme

# Paths on the host where persistent data lives.
# wideworks mounts these from their file storage.
REGISTRY_DATA_DIR=/mnt/registry/data
REGISTRY_TARBALL_DIR=/mnt/registry/tarballs

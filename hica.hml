@project {
    name: "hica-registry"
    version: "0.1.0"
    license: "MIT"
    entry: "src/main.hc"
}

@dependencies {
    json: "1.0.0"
    sqlite: "0.4.0"
    http: "1.1.1"
}

@description {
    summary: "Registry for hica libraries"
    author: "cladam"
    homepage: "https://www.hica.dev"
    repository: "https://github.com/cladam/hica-registry"
}

@koka {
    flags: "--cclib=microhttpd --cclib=sqlite3 --cclib=curl --ccincdir=/opt/homebrew/include --cclinkopts=-L/opt/homebrew/lib"
}
